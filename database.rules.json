{
  "rules": {
    ".read": false,
    ".write": false,
    "responses": {
      "$uid": {
        "$session": {
          ".validate": "newData.hasChildren([\"client_version\", \"session_id\", \"started_at\", \"completed_at\", \"saved_at\", \"consent\", \"demographics\", \"recruitment\", \"block_order\", \"trial_count\", \"trials\"])",
          "client_version": {
            ".validate": "newData.val() == \"emotion-v6\""
          },
          "session_id": {
            ".validate": "newData.isString() && newData.val() == $session"
          },
          "started_at": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1e+16"
          },
          "completed_at": {
            ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('started_at').val()"
          },
          "saved_at": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "consent": {
            ".validate": "newData.hasChildren([\"agreed\", \"version\", \"agreed_at\", \"rt_ms\"])",
            "agreed": {
              ".validate": "newData.val() == true"
            },
            "version": {
              ".validate": "newData.val() == \"2026-10-20-v4\""
            },
            "agreed_at": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1e+16"
            },
            "rt_ms": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1e+16"
            },
            "$other": {
              ".validate": false
            }
          },
          "demographics": {
            ".validate": "newData.hasChildren([\"age\", \"gender\", \"ethnicity\", \"area_of_study\", \"education\", \"rt_ms\"])",
            "age": {
              ".validate": "newData.val() == \"18-21\" || newData.val() == \"22-30\" || newData.val() == \"31-40\" || newData.val() == \"41-60\" || newData.val() == \"60+\""
            },
            "gender": {
              ".validate": "newData.val() == \"Male\" || newData.val() == \"Female\""
            },
            "ethnicity": {
              ".validate": "newData.val() == \"European\" || newData.val() == \"Middle Eastern\" || newData.val() == \"Black, African, or Caribbean\" || newData.val() == \"Chinese\" || newData.val() == \"Indian\" || newData.val() == \"Indigenous\""
            },
            "area_of_study": {
              ".validate": "newData.val() == \"STEM\" || newData.val() == \"Social Sciences\" || newData.val() == \"Humanities\" || newData.val() == \"Other\""
            },
            "education": {
              ".validate": "newData.val() == \"High school diploma\" || newData.val() == \"Attending post-secondary\" || newData.val() == \"Post-secondary degree\" || newData.val() == \"Graduate degree\" || newData.val() == \"Prefer not to say\""
            },
            "rt_ms": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1e+16"
            },
            "$other": {
              ".validate": false
            }
          },
          "recruitment": {
            ".validate": "newData.hasChildren([\"cloudresearch_id\", \"pid\", \"workerId\", \"PROLIFIC_PID\", \"participantId\", \"assignmentId\", \"projectId\"])",
            "pid": {
              ".validate": "newData.isString() && newData.val().length <= 512"
            },
            "workerId": {
              ".validate": "newData.isString() && newData.val().length <= 512"
            },
            "PROLIFIC_PID": {
              ".validate": "newData.isString() && newData.val().length <= 512"
            },
            "participantId": {
              ".validate": "newData.isString() && newData.val().length <= 512"
            },
            "assignmentId": {
              ".validate": "newData.isString() && newData.val().length <= 512"
            },
            "projectId": {
              ".validate": "newData.isString() && newData.val().length <= 512"
            },
            "$other": {
              ".validate": false
            },
            "cloudresearch_id": {
              ".validate": "newData.isString() && newData.val().length <= 128 && newData.val().matches(/.*\\S.*/)"
            }
          },
          "block_order": {
            ".validate": "newData.hasChildren(['0','1']) && newData.child('0').val() != newData.child('1').val()",
            "0": {
              ".validate": "newData.val() == \"Male\" || newData.val() == \"Female\""
            },
            "1": {
              ".validate": "newData.val() == \"Male\" || newData.val() == \"Female\""
            },
            "$other": {
              ".validate": false
            }
          },
          "trial_count": {
            ".validate": "newData.val() == 166"
          },
          "trials": {
            ".validate": "newData.hasChildren([\"001\", \"002\", \"003\", \"004\", \"005\", \"006\", \"007\", \"008\", \"009\", \"010\", \"011\", \"012\", \"013\", \"014\", \"015\", \"016\", \"017\", \"018\", \"019\", \"020\", \"021\", \"022\", \"023\", \"024\", \"025\", \"026\", \"027\", \"028\", \"029\", \"030\", \"031\", \"032\", \"033\", \"034\", \"035\", \"036\", \"037\", \"038\", \"039\", \"040\", \"041\", \"042\", \"043\", \"044\", \"045\", \"046\", \"047\", \"048\", \"049\", \"050\", \"051\", \"052\", \"053\", \"054\", \"055\", \"056\", \"057\", \"058\", \"059\", \"060\", \"061\", \"062\", \"063\", \"064\", \"065\", \"066\", \"067\", \"068\", \"069\", \"070\", \"071\", \"072\", \"073\", \"074\", \"075\", \"076\", \"077\", \"078\", \"079\", \"080\", \"081\", \"082\", \"083\", \"084\", \"085\", \"086\", \"087\", \"088\", \"089\", \"090\", \"091\", \"092\", \"093\", \"094\", \"095\", \"096\", \"097\", \"098\", \"099\", \"100\", \"101\", \"102\", \"103\", \"104\", \"105\", \"106\", \"107\", \"108\", \"109\", \"110\", \"111\", \"112\", \"113\", \"114\", \"115\", \"116\", \"117\", \"118\", \"119\", \"120\", \"121\", \"122\", \"123\", \"124\", \"125\", \"126\", \"127\", \"128\", \"129\", \"130\", \"131\", \"132\", \"133\", \"134\", \"135\", \"136\", \"137\", \"138\", \"139\", \"140\", \"141\", \"142\", \"143\", \"144\", \"145\", \"146\", \"147\", \"148\", \"149\", \"150\", \"151\", \"152\", \"153\", \"154\", \"155\", \"156\", \"157\", \"158\", \"159\", \"160\", \"161\", \"162\", \"163\", \"164\", \"165\", \"166\"])",
            "$trial": {
              ".validate": "newData.hasChildren([\"trial_number\", \"block\", \"block_index\", \"within_block_index\", \"image\", \"filename\", \"image_category\", \"rating\", \"response_key\", \"rt_ms\", \"selected_emotion\", \"classification_key\", \"classification_rt_ms\"]) && ((newData.child('block_index').val() == 1 && newData.child('block').val() == newData.parent().parent().child('block_order/0').val() && newData.child('trial_number').val() == newData.child('within_block_index').val()) || (newData.child('block_index').val() == 2 && newData.child('block').val() == newData.parent().parent().child('block_order/1').val() && ((newData.child('block').val() == 'Male' && newData.child('trial_number').val() == 84 + newData.child('within_block_index').val()) || (newData.child('block').val() == 'Female' && newData.child('trial_number').val() == 82 + newData.child('within_block_index').val())))) && $trial.matches(/^(00[1-9]|0[1-9][0-9]|1[0-5][0-9]|16[0-6])$/)",
              "trial_number": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 166 && newData.val() % 1 == 0 && $trial == (newData.val() < 10 ? '00' + newData.val() : (newData.val() < 100 ? '0' + newData.val() : '' + newData.val()))"
              },
              "block": {
                ".validate": "newData.val() == \"Male\" || newData.val() == \"Female\""
              },
              "block_index": {
                ".validate": "newData.val() == 1 || newData.val() == 2"
              },
              "within_block_index": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 == 0 && ((newData.parent().child('block').val() == 'Male' && newData.val() <= 82) || (newData.parent().child('block').val() == 'Female' && newData.val() <= 84))"
              },
              "image": {
                ".validate": "newData.val() == 'all_images/' + newData.parent().child('filename').val()"
              },
              "filename": {
                ".validate": "newData.isString() && ((newData.parent().child('block').val() == 'Male' && newData.val().matches(/^M_.*$/)) || (newData.parent().child('block').val() == 'Female' && newData.val().matches(/^F_.*$/))) && newData.val().matches(/^(F_An_1\\.jpg|F_An_10\\.jpg|F_An_11\\.jpg|F_An_12\\.jpg|F_An_13\\.jpg|F_An_14\\.jpg|F_An_15\\.jpg|F_An_16\\.jpg|F_An_17\\.jpg|F_An_18\\.jpg|F_An_19\\.jpg|F_An_2\\.jpg|F_An_20\\.jpg|F_An_21\\.jpg|F_An_22\\.jpg|F_An_23\\.jpg|F_An_24\\.jpg|F_An_25\\.jpg|F_An_26\\.jpg|F_An_27\\.jpg|F_An_28\\.jpg|F_An_29\\.jpg|F_An_3\\.jpg|F_An_30\\.jpg|F_An_31\\.jpg|F_An_32\\.jpg|F_An_33\\.jpg|F_An_34\\.jpg|F_An_35\\.jpg|F_An_36\\.jpg|F_An_37\\.jpg|F_An_38\\.jpg|F_An_39\\.jpg|F_An_4\\.jpg|F_An_40\\.jpg|F_An_41\\.jpg|F_An_42\\.jpg|F_An_43\\.jpg|F_An_44\\.jpg|F_An_5\\.jpg|F_An_6\\.jpg|F_An_7\\.jpg|F_An_8\\.jpg|F_An_9\\.jpg|F_Hp_1\\.jpg|F_Hp_2\\+\\.jpg|F_Hp_3\\.jpg|F_Hp_4\\+\\.jpg|F_Hp_5\\.jpg|F_Nu_10\\.jpg|F_Nu_11\\.jpg|F_Nu_12\\.jpg|F_Nu_13\\.jpg|F_Nu_14\\.jpg|F_Nu_15\\.jpg|F_Nu_16\\.jpg|F_Nu_17\\.jpg|F_Nu_18\\.jpg|F_Nu_19\\.jpg|F_Nu_20\\.jpg|F_Nu_21\\.jpg|F_Nu_22\\.jpg|F_Nu_23\\.jpg|F_Nu_24\\.jpg|F_Nu_25\\.jpg|F_Nu_26\\.jpg|F_Nu_27\\.jpg|F_Nu_28\\.jpg|F_Nu_29\\.jpg|F_Nu_30\\.jpg|F_Nu_31\\.jpg|F_Nu_32\\.jpg|F_Nu_33\\.jpg|F_Nu_34\\.jpg|F_Nu_35\\.jpg|F_Nu_36\\.jpg|F_Nu_37\\.jpg|F_Nu_38\\.jpg|F_Nu_39\\.jpg|F_Nu_40\\.jpg|F_Nu_6\\.jpg|F_Nu_7\\.jpg|F_Nu_8\\.jpg|F_Nu_9\\.jpg|M_An_1\\.jpg|M_An_10\\.jpg|M_An_11\\.jpg|M_An_12\\.jpg|M_An_13\\.jpg|M_An_14\\.jpg|M_An_15\\.jpg|M_An_16\\.jpg|M_An_17\\.jpg|M_An_18\\.jpg|M_An_19\\.jpg|M_An_2\\.jpg|M_An_20\\.jpg|M_An_21\\.jpg|M_An_22\\.jpg|M_An_23\\.jpg|M_An_24\\.jpg|M_An_25\\.jpg|M_An_26\\.jpg|M_An_27\\.jpg|M_An_28\\.jpg|M_An_29\\.jpg|M_An_3\\.jpg|M_An_30\\.jpg|M_An_31\\.jpg|M_An_32\\.jpg|M_An_33\\.jpg|M_An_34\\.jpg|M_An_35\\.jpg|M_An_36\\.jpg|M_An_37\\.jpg|M_An_38\\.jpg|M_An_39\\.jpg|M_An_4\\.jpg|M_An_40\\.jpg|M_An_41\\.jpg|M_An_5\\.jpg|M_An_6\\.jpg|M_An_7\\.jpg|M_An_8\\.jpg|M_An_9\\.jpg|M_Hp_37\\.jpg|M_Hp_38\\.jpg|M_Hp_39\\.jpg|M_Hp_40\\+\\.jpg|M_Hp_41\\+\\.jpg|M_Nu_1\\.jpg|M_Nu_10\\.jpg|M_Nu_11\\.jpg|M_Nu_12\\.jpg|M_Nu_13\\.jpg|M_Nu_14\\.jpg|M_Nu_15\\.jpg|M_Nu_16\\.jpg|M_Nu_17\\.jpg|M_Nu_18\\.jpg|M_Nu_19\\.jpg|M_Nu_2\\.jpg|M_Nu_20\\.jpg|M_Nu_21\\.jpg|M_Nu_22\\.jpg|M_Nu_23\\.jpg|M_Nu_24\\.jpg|M_Nu_25\\.jpg|M_Nu_26\\.jpg|M_Nu_27\\.jpg|M_Nu_28\\.jpg|M_Nu_29\\.jpg|M_Nu_3\\.jpg|M_Nu_30\\.jpg|M_Nu_31\\.jpg|M_Nu_32\\.jpg|M_Nu_33\\.jpg|M_Nu_34\\.jpg|M_Nu_35\\.jpg|M_Nu_36\\.jpg|M_Nu_4\\.jpg|M_Nu_5\\.jpg|M_Nu_6\\.jpg|M_Nu_7\\.jpg|M_Nu_8\\.jpg|M_Nu_9\\.jpg)$/)"
              },
              "image_category": {
                ".validate": "(newData.val() == 'An' && newData.parent().child('filename').val().matches(/^[MF]_An_.*$/)) || (newData.val() == 'Nu' && newData.parent().child('filename').val().matches(/^[MF]_Nu_.*$/)) || (newData.val() == 'Hp' && newData.parent().child('filename').val().matches(/^[MF]_Hp_.*$/))"
              },
              "rating": {
                ".validate": "newData.val() == 1 || newData.val() == 2 || newData.val() == 3 || newData.val() == 4 || newData.val() == 5 || newData.val() == 6 || newData.val() == 7"
              },
              "response_key": {
                ".validate": "newData.isString() && newData.val() == '' + newData.parent().child('rating').val()"
              },
              "rt_ms": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1e+16"
              },
              "$other": {
                ".validate": false
              },
              "selected_emotion": {
                ".validate": "(newData.val() == 'angry' && newData.parent().child('classification_key').val() == 'b') || (newData.val() == 'neutral' && newData.parent().child('classification_key').val() == 'n') || (newData.val() == 'happy' && newData.parent().child('classification_key').val() == 'm')"
              },
              "classification_key": {
                ".validate": "newData.val() == 'b' || newData.val() == 'n' || newData.val() == 'm'"
              },
              "classification_rt_ms": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1e+16"
              }
            }
          },
          "$other": {
            ".validate": false
          },
          ".write": "auth != null && auth.uid == $uid && newData.exists()"
        }
      }
    }
  }
}
